{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "ES2018",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2018", "ES2020.BigInt", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["src", "test"]
}
